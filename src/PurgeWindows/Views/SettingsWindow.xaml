<Window xmlns:loc="clr-namespace:PurgeWindows.Localization" xmlns:core="clr-namespace:PurgeWindows.Core" x:Class="PurgeWindows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:S.SettingsTitle}" Width="610" Height="740" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Window.Resources>
        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,6,22,6" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                                    BorderBrush="#45454D" BorderThickness="1.5" Background="{StaticResource Surface2Brush}">
                                <TextBlock x:Name="Mark" Text="" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="#111113" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Mark" Property="Text" Value="&#xE73E;" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Circle" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left"
                                    BorderBrush="#45454D" BorderThickness="1.5" Background="{StaticResource Surface2Brush}">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#111113" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Circle" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="32,6,0,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{x:Static loc:S.SettingsSection}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:S.SettingsSectionHint}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
            <StackPanel x:Name="Options">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:S.RemovalSectionTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,14" Text="{x:Static loc:S.RemovalSectionHint}" />
                        <RadioButton x:Name="RemovalDefaultRadio" GroupName="Removal" Content="{x:Static loc:S.RemovalDefault}" Style="{StaticResource SettingRadio}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.RemovalDefaultHint}" />
                        <RadioButton x:Name="RemovalBinRadio" GroupName="Removal" Content="{x:Static loc:S.RemovalBin}" Style="{StaticResource SettingRadio}" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.RemovalBinHint}" />
                        <RadioButton x:Name="RemovalPermanentRadio" GroupName="Removal" Content="{x:Static loc:S.RemovalPermanent}" Style="{StaticResource SettingRadio}" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.RemovalPermanentHint}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="BackgroundCheck" Content="{x:Static loc:S.KeepInTray}" Style="{StaticResource SettingCheck}" Click="Background_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.KeepInTrayHint}" />
                        <CheckBox x:Name="StartupCheck" Content="{x:Static loc:S.StartWithWindows}" Style="{StaticResource SettingCheck}" Margin="0,20,0,0" Click="EnableBackground_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.StartWithWindowsHint}" />
                        <TextBlock x:Name="StartupMessage" Style="{StaticResource Hint}" Foreground="{StaticResource WarnBrush}" />
                        <Button Content="{x:Static loc:S.WindowsStartupSettings}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7"
                                HorizontalAlignment="Left" Margin="32,10,0,0" Click="StartupSettings_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="LowSpaceCheck" Content="{x:Static loc:S.LowSpaceAlerts}" Style="{StaticResource SettingCheck}" Click="EnableBackground_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.LowSpaceAlertsHint}" />
                        <WrapPanel Margin="32,14,0,0">
                            <TextBlock Text="{x:Static loc:S.Below}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ThresholdBox" Width="58" Padding="6" Background="{StaticResource Surface2Brush}"
                                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" AutomationProperties.Name="Low-space threshold in GB" />
                            <TextBlock Text="{x:Static loc:S.GbCheckEvery}" VerticalAlignment="Center" Margin="8,0" />
                            <ComboBox x:Name="IntervalBox" Width="118" Style="{StaticResource SettingCombo}" SelectedValuePath="Tag" AutomationProperties.Name="Check interval">
                                <ComboBoxItem Content="{x:Static loc:S.Minutes30}" Tag="30" />
                                <ComboBoxItem Content="{x:Static loc:S.Minutes60}" Tag="60" />
                            </ComboBox>
                        </WrapPanel>
                        <CheckBox x:Name="WeeklyCheck" Content="{x:Static loc:S.WeeklyCacheCheck}" Style="{StaticResource SettingCheck}" Margin="0,22,0,0" Click="EnableBackground_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.WeeklyCacheHint}" />
                        <TextBlock x:Name="PauseStatus" Style="{StaticResource Hint}" Margin="32,18,0,0" />
                        <WrapPanel Margin="32,10,0,0">
                            <Button Content="{x:Static loc:S.PauseForDay}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7" Margin="0,0,8,8" Click="Pause_Click" />
                            <Button Content="{x:Static loc:S.Resume}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7" Margin="0,0,0,8" Click="Resume_Click" />
                        </WrapPanel>
                        <Button Content="{x:Static loc:S.WindowsNotificationSettings}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7"
                                HorizontalAlignment="Left" Margin="32,2,0,0" Click="NotificationSettings_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border x:Name="WindowsCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:S.WindowsSettingsTitle}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,16" Text="{x:Static loc:S.WindowsSettingsHint}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Surface2Brush}" VerticalAlignment="Top">
                            <TextBlock Text="{x:Static core:G.Clock}" FontFamily="{StaticResource IconFont}" FontSize="19"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <CheckBox x:Name="HibernateCheck" Content="{x:Static loc:S.HibernateTitle}" Style="{StaticResource SettingCheck}" Click="Hibernate_Click" />
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:S.HibernateHint}" />
                            <TextBlock x:Name="HibernateStateText" Style="{StaticResource Hint}" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Surface2Brush}" VerticalAlignment="Top">
                            <TextBlock Text="{x:Static core:G.Update}" FontFamily="{StaticResource IconFont}" FontSize="19"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{x:Static loc:S.DeliveryOptTitle}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{x:Static loc:S.DeliveryOptHint}" />
                            <TextBlock x:Name="DeliveryOptAdminText" Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="{StaticResource WarnBrush}"
                                       Text="{x:Static loc:S.DeliveryOptNeedsAdmin}" />
                            <Button x:Name="ClearDeliveryOptButton" Content="{x:Static loc:S.ClearCacheNow}" Style="{StaticResource SecondaryButton}"
                                    FontSize="12" Padding="12,7" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ClearDeliveryOpt_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="WindowsStatus" Style="{StaticResource Hint}" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12.5" Margin="0,0,0,12" />
            <Grid>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" AutomationProperties.Name="Purge for Windows version" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:S.Cancel}" IsCancel="True" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="{x:Static loc:S.SaveSettings}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
